# Fuente única de versiones de herramientas (LAB-99): la leen el workflow de CI, el Makefile y
# scripts/check-tools.sh, de modo que CI y `make check` usan exactamente las mismas. Formato KEY=VALUE sin comillas.
# Nunca `latest` ni rangos. Los tags de imagen deben coincidir con docker-compose.yml.
TERRAFORM_VERSION=1.15.8
TFLINT_VERSION=0.65.0
TFLINT_AWS_RULESET_VERSION=0.50.0
TRIVY_VERSION=0.72.0
FLOCI_IMAGE=floci/floci:2.3.0
# Tiempos límite en segundos.
FLOCI_READY_TIMEOUT=120
ARGOCD_TIMEOUT=600
