# Copia este archivo como secrets.auto.tfvars (está en .gitignore) y pon valores locales de prueba.
# También puedes usar la variable de entorno TF_VAR_secrets con el mismo contenido en formato HCL.
# Nunca subas valores reales al repositorio.
secrets = {
  postgres-password = "CHANGE_ME"
  llm-api-key       = "CHANGE_ME"
  # LAB-64: JSON con las diez claves de Langfuse (ver docs/observability.md). Sustituye cada CHANGE_ME por un valor local.
  langfuse = "{\"POSTGRES_PASSWORD\":\"CHANGE_ME\",\"CLICKHOUSE_PASSWORD\":\"CHANGE_ME\",\"REDIS_AUTH\":\"CHANGE_ME\",\"MINIO_ROOT_PASSWORD\":\"CHANGE_ME\",\"SALT\":\"CHANGE_ME\",\"ENCRYPTION_KEY\":\"CHANGE_ME\",\"NEXTAUTH_SECRET\":\"CHANGE_ME\",\"LANGFUSE_INIT_PROJECT_PUBLIC_KEY\":\"CHANGE_ME\",\"LANGFUSE_INIT_PROJECT_SECRET_KEY\":\"CHANGE_ME\",\"LANGFUSE_INIT_USER_PASSWORD\":\"CHANGE_ME\"}"
  # Gateway de modelos LiteLLM (LAB-84): clave maestra, claves virtuales del backend, de ingest y de la evaluación de calidad
  # de respuesta (LAB-29; formato sk-..., sin marcadores change-me/local en dev) y contraseña de su Postgres.
  # CLOUD_PROVIDER_API_KEY es opcional: sin ella no existe chat-cloud. `make secrets` añade lo que falte, sin tocar lo que hay.
  litellm = "{\"LITELLM_MASTER_KEY\":\"CHANGE_ME\",\"LITELLM_KEY_BACKEND\":\"CHANGE_ME\",\"LITELLM_KEY_INGEST\":\"CHANGE_ME\",\"LITELLM_KEY_EVAL\":\"CHANGE_ME\",\"POSTGRES_PASSWORD\":\"CHANGE_ME\"}"
  # Historial de evaluación (LAB-31): el token con el que `eval/` guarda cada ejecución en el backend
  # (shoplab.eval.persistence.token). Es opcional: sin él el backend rechaza guardar y todo lo demás funciona igual.
  # `make secrets` lo genera si falta (64 hexadecimales), sin tocar lo que ya hay.
  eval = "{\"EVAL_PERSISTENCE_TOKEN\":\"CHANGE_ME\"}"
}

parameters = {
  llm-model = "llama3.2:3b"
}
