# Copia este archivo como secrets.auto.tfvars (está en .gitignore) y pon valores locales de prueba.
# También puedes usar la variable de entorno TF_VAR_secrets con el mismo contenido en formato HCL.
# Nunca subas valores reales al repositorio.
secrets = {
  postgres-password = "CHANGE_ME"
  llm-api-key       = "CHANGE_ME"
  # LAB-64: JSON con las diez claves de Langfuse (ver docs/observability.md). Sustituye cada CHANGE_ME por un valor local.
  langfuse = "{\"POSTGRES_PASSWORD\":\"CHANGE_ME\",\"CLICKHOUSE_PASSWORD\":\"CHANGE_ME\",\"REDIS_AUTH\":\"CHANGE_ME\",\"MINIO_ROOT_PASSWORD\":\"CHANGE_ME\",\"SALT\":\"CHANGE_ME\",\"ENCRYPTION_KEY\":\"CHANGE_ME\",\"NEXTAUTH_SECRET\":\"CHANGE_ME\",\"LANGFUSE_INIT_PROJECT_PUBLIC_KEY\":\"CHANGE_ME\",\"LANGFUSE_INIT_PROJECT_SECRET_KEY\":\"CHANGE_ME\",\"LANGFUSE_INIT_USER_PASSWORD\":\"CHANGE_ME\"}"
}

parameters = {
  llm-model = "llama3.2:3b"
}
