# Copia este archivo como secrets.auto.tfvars (está en .gitignore) y pon valores locales de prueba.
# También puedes usar la variable de entorno TF_VAR_secrets con el mismo contenido en formato HCL.
# Nunca subas valores reales al repositorio.
secrets = {
  postgres-password = "CHANGE_ME"
  llm-api-key       = "CHANGE_ME"
}

parameters = {
  llm-model = "llama3.2:3b"
}
